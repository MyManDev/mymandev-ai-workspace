# Local configuration for `npm run dev`. Copy this file to `.env` and change
# what you need; `.env` is ignored by Git and is never committed.
# Every variable is optional. The values below are the defaults.
# README.md describes the accepted values.

NODE_ENV=development
# Loopback only until authentication exists: 127.0.0.1, ::1 or localhost.
API_HOST=127.0.0.1
API_PORT=3000
API_LOG_LEVEL=info
API_BODY_LIMIT_BYTES=65536
# Comma-separated browser origins allowed to open /ws, for example
# https://app.example,http://localhost:5173. Empty: no browser origin.
API_ALLOWED_ORIGINS=
