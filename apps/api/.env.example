# Local configuration for `npm run dev`. Copy this file to `.env` and change
# what you need; `.env` is ignored by Git and is never committed.
# Every variable is optional. The values below are the defaults.
# README.md describes the accepted values.

NODE_ENV=development
# Loopback only until authentication exists: 127.0.0.1, ::1 or localhost.
API_HOST=127.0.0.1
API_PORT=3000
API_LOG_LEVEL=info
API_BODY_LIMIT_BYTES=65536
# Comma-separated browser origins allowed to open /ws, for example
# https://app.example,http://localhost:5173. Empty: no browser origin.
API_ALLOWED_ORIGINS=

# GitHub sign-in (ADR 0014). Set all three or none; without them sign-in is
# disabled. In development the origin may be http with a loopback host. The
# client ID and secret come from your development GitHub App
# (docs/development/GITHUB-APP.md). Never commit a real secret.
API_PUBLIC_ORIGIN=
API_GITHUB_CLIENT_ID=
API_GITHUB_CLIENT_SECRET=

# PostgreSQL, for example postgres://user:password@127.0.0.1:5432/mymandev.
# Without it the routes that need the database are disabled.
DATABASE_URL=
