# Local configuration for `npm run db:migrate`. Copy this file to `.env` and
# replace the placeholder password; `.env` is ignored by Git and is never
# committed. A variable set in the environment wins over this file.
# README.md describes the database roles and the accepted URL forms.

# Connection URL of the migration role, which owns the schema.
# sslmode: absent, disable or verify-full; verify-full is required when
# NODE_ENV=production.
DATABASE_MIGRATION_URL=postgres://mymandev_migrator:change-me@127.0.0.1:5432/mymandev?sslmode=disable
