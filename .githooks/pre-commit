#!/bin/sh

set -eu

name="$(git config user.name || true)"
email="$(git config user.email || true)"
identity="$name $email"

if printf "%s" "$identity" | grep -Eiq "(claude|anthropic|chatgpt|openai|codex)"; then
  echo "ERROR: AI Git identity detected."
  echo "Current identity: $identity"
  exit 1
fi

exit 0
